  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
